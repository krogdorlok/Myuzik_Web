{
  "name": "myuzik-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "prepare": "cd .. && husky frontend/.husky",
    "measure:live": "MEASURE=1 playwright test e2e/measure-live.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "perf": "mkdir -p node_modules/.cache && next build > node_modules/.cache/next-build.txt && cat node_modules/.cache/next-build.txt && PERF=1 playwright test e2e/perf.spec.ts --project=chromium",
    "test:ci": "vitest run --coverage",
    "metrics:tests": "node scripts/test-metrics.mjs"
  },
  "dependencies": {
    "next": "^14.1.0",
    "pino": "^9.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^1.2.1"
  }
}
